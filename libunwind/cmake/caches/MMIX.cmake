# Static native bare-metal unwinder. The caller selects compiler and C sysroot.
set(CMAKE_SYSTEM_NAME Generic CACHE STRING "")
set(CMAKE_SYSTEM_PROCESSOR mmix CACHE STRING "")
set(CMAKE_TRY_COMPILE_TARGET_TYPE STATIC_LIBRARY CACHE STRING "")
set(CMAKE_C_COMPILER_TARGET mmix-unknown-unknown CACHE STRING "")
set(CMAKE_CXX_COMPILER_TARGET mmix-unknown-unknown CACHE STRING "")
set(CMAKE_ASM_COMPILER_TARGET mmix-unknown-unknown CACHE STRING "")
set(CMAKE_POSITION_INDEPENDENT_CODE OFF CACHE BOOL "")
set(CMAKE_CXX_FLAGS "-fno-exceptions -fno-rtti" CACHE STRING "")
set(LLVM_ENABLE_RUNTIMES libunwind CACHE STRING "")
set(LLVM_DEFAULT_TARGET_TRIPLE mmix-unknown-unknown CACHE STRING "")
set(LIBUNWIND_ENABLE_SHARED OFF CACHE BOOL "")
set(LIBUNWIND_ENABLE_STATIC ON CACHE BOOL "")
set(LIBUNWIND_ENABLE_THREADS OFF CACHE BOOL "")
set(LIBUNWIND_ENABLE_CROSS_UNWINDING OFF CACHE BOOL "")
set(LIBUNWIND_IS_BAREMETAL ON CACHE BOOL "")
set(LIBUNWIND_USE_COMPILER_RT ON CACHE BOOL "")
set(LIBUNWIND_ENABLE_FRAME_APIS OFF CACHE BOOL "")
set(LIBUNWIND_USE_FRAME_HEADER_CACHE OFF CACHE BOOL "")
set(LIBUNWIND_ENABLE_ASSERTIONS OFF CACHE BOOL "")
set(LIBUNWIND_INCLUDE_TESTS OFF CACHE BOOL "")
set(LIBUNWIND_INCLUDE_DOCS OFF CACHE BOOL "")
set(LIBUNWIND_INSTALL_INCLUDE_DIR include/mmix-unknown-unknown CACHE STRING "")
set(LIBUNWIND_INSTALL_LIBRARY_DIR lib/mmix-unknown-unknown CACHE STRING "")
# Do not infer target loader, thread or GNU runtime availability from the host.
set(LIBUNWIND_HAS_DL_LIB OFF CACHE BOOL "")
set(LIBUNWIND_HAS_PTHREAD_LIB OFF CACHE BOOL "")
