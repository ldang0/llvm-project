# RUN: llc -mtriple=mmix -run-pass=postrapseudos -verify-machineinstrs %s -o - | FileCheck %s
# RUN: llc -mtriple=mmix -start-before=postrapseudos -verify-machineinstrs \
# RUN:   -filetype=asm %s -o - | FileCheck %s --check-prefix=ASM

# ASM-LABEL: address_materialization:
# ASM:       SETH r0, ([[CPI:\.LCPI[0-9]+_0]]>>48)&65535
# ASM-NEXT:  INCMH r0, ([[CPI]]>>32)&65535
# ASM-NEXT:  INCML r0, ([[CPI]]>>16)&65535
# ASM-NEXT:  INCL r0, [[CPI]]&65535
# ASM-NEXT:  SETH r1, ([[JTI:\.LJTI[0-9]+_0]]>>48)&65535
# ASM-NEXT:  INCMH r1, ([[JTI]]>>32)&65535
# ASM-NEXT:  INCML r1, ([[JTI]]>>16)&65535
# ASM-NEXT:  INCL r1, [[JTI]]&65535
# ASM-NEXT:  SETH r2, (external_name>>48)&65535
# ASM-NEXT:  INCMH r2, (external_name>>32)&65535
# ASM-NEXT:  INCML r2, (external_name>>16)&65535
# ASM-NEXT:  INCL r2, external_name&65535
# ASM-NEXT:  SETH r3, (external_callee>>48)&65535
# ASM-NEXT:  INCMH r3, (external_callee>>32)&65535
# ASM-NEXT:  INCML r3, (external_callee>>16)&65535
# ASM-NEXT:  INCL r3, external_callee&65535

--- |
  define void @address_materialization() {
  entry:
    ret void
  }
...
---
name: address_materialization
tracksRegLiveness: true
constants:
  - id: 0
    value: 'i64 1234605616436508552'
    alignment: 8
jumpTable:
  # Jump-table CodeGen remains disabled; this fixture keeps its address
  # producer structurally covered until that owning milestone enables it.
  kind: block-address
  entries:
    - id: 0
      blocks: [ '%bb.0' ]
body: |
  bb.0.entry:
    ; CHECK-LABEL: name: address_materialization
    ; CHECK:      $r0 = LOAD_ADDR %const.0
    ; CHECK-NEXT: $r1 = LOAD_ADDR %jump-table.0
    ; CHECK-NEXT: $r2 = LOAD_ADDR &external_name
    ; CHECK-NEXT: $r3 = LOAD_CALL_ADDR &external_callee
    $r0 = LOAD_ADDR %const.0
    $r1 = LOAD_ADDR %jump-table.0
    $r2 = LOAD_ADDR &external_name
    $r3 = LOAD_CALL_ADDR &external_callee
    POP 0, 0
...
