# RUN: llc -mtriple=mmix -start-after=block-placement -verify-machineinstrs \
# RUN:   -filetype=asm -o - %s | FileCheck %s

# CHECK-LABEL: branch_directions:
# CHECK:       [[START:.LBB[0-9]+_0]]:
# CHECK-NEXT:  JMP [[FORWARD:.LBB[0-9]+_2]]
# CHECK:       [[BACKWARD:.LBB[0-9]+_1]]:
# CHECK-NEXT:  JMPB [[START]]
# CHECK:       [[FORWARD]]:
# CHECK-NEXT:  BNZB r1, [[BACKWARD]]

--- |
  define void @branch_directions() {
    ret void
  }
...
---
name:            branch_directions
alignment:       4
tracksRegLiveness: true
selected:        true
liveins:
  - { reg: '$r1' }
body:             |
  bb.0:
    PseudoJMP %bb.2

  bb.1:
    PseudoJMP %bb.0

  bb.2:
    liveins: $r1

    PseudoB $r1, %bb.1, 5
    PseudoJMP %bb.0
...
