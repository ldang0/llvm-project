# RUN: llc -mtriple=mmix -start-after=block-placement -verify-machineinstrs \
# RUN:   -filetype=asm -o - %s | FileCheck %s
# RUN: llc -mtriple=mmix -start-after=block-placement -verify-machineinstrs \
# RUN:   -filetype=obj -o %t.o %s
# RUN: llvm-readobj --relocations --expand-relocs %t.o \
# RUN:   | FileCheck %s --check-prefix=OBJ
# RUN: llvm-objdump --no-print-imm-hex -dr %t.o \
# RUN:   | FileCheck %s --check-prefix=DIS --implicit-check-not='<unknown>'

# CHECK-LABEL: branch_directions:
# CHECK:       [[START:.LBB[0-9]+_0]]:
# CHECK-NEXT:  JMP [[FORWARD:.LBB[0-9]+_2]]
# CHECK:       [[BACKWARD:.LBB[0-9]+_1]]:
# CHECK-NEXT:  JMPB [[START]]
# CHECK:       [[FORWARD]]:
# CHECK-NEXT:  BNZB r1, [[BACKWARD]]
# CHECK:       [[SELF:.LBB[0-9]+_3]]:
# CHECK-NEXT:  JMP [[SELF]]

# All local targets resolve during object layout. Exact instruction addresses
# and displacements cover four-byte scaling, alignment, and both directions.
# OBJ:      Relocations [
# OBJ-NEXT: ]
# DIS-LABEL: <branch_directions>:
# DIS-NEXT:  {{ *}}0: f0 00 00 02{{.*}}JMP 2
# DIS-NEXT:  {{ *}}4: f1 ff ff ff{{.*}}JMPB -1
# DIS-NEXT:  {{ *}}8: 4b 01 ff ff{{.*}}BNZB r1, -1
# DIS-NEXT:  {{ *}}c: f1 ff ff fd{{.*}}JMPB -3
# DIS-NEXT:  {{ *}}10: f0 00 00 00{{.*}}JMP 0

--- |
  define void @branch_directions() nounwind {
    ret void
  }
...
---
name:            branch_directions
alignment:       4
tracksRegLiveness: true
selected:        true
liveins:
  - { reg: '$r1' }
body:             |
  bb.0:
    PseudoJMP %bb.2

  bb.1:
    PseudoJMP %bb.0

  bb.2:
    liveins: $r1

    PseudoB $r1, %bb.1, 5
    PseudoJMP %bb.0

  bb.3:
    PseudoJMP %bb.3
...
