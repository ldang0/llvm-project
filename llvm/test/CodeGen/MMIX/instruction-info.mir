# RUN: llc -mtriple=mmix -run-pass=postrapseudos -verify-machineinstrs \
# RUN:   -o - %s | FileCheck %s --check-prefix=COPY
# RUN: llc -mtriple=mmix -run-pass=greedy,virtregrewriter \
# RUN:   -stress-regalloc=2 -verify-machineinstrs -o - %s \
# RUN:   | FileCheck %s --check-prefix=SPILL

--- |
  define void @copy_registers() {
    ret void
  }

  define void @spill_gpr() {
    ret void
  }

  define void @spill_fpr() {
    ret void
  }
...
---
name:            copy_registers
tracksRegLiveness: true
liveins:
  - { reg: '$r231' }
body:             |
  bb.0:
    liveins: $r231

    ; Integer and floating-point values share the same physical registers.
    ; COPY-LABEL: name: copy_registers
    ; COPY: $r232 = ORI killed $r231, 0
    renamable $r232 = COPY killed renamable $r231
...
---
name:            spill_gpr
tracksRegLiveness: true
registers:
  - { id: 0, class: gpr64codegen }
  - { id: 1, class: gpr64codegen }
  - { id: 2, class: gpr64codegen }
  - { id: 3, class: gpr64codegen }
  - { id: 4, class: gpr64codegen }
body:             |
  bb.0:
    ; SPILL-LABEL: name: spill_gpr
    ; SPILL: STOUI {{.*}}, %stack.{{[0-9]+}}, 0 :: (store (s64)
    ; SPILL: {{.*}} = LDOUI %stack.{{[0-9]+}}, 0 :: (load (s64)
    %0:gpr64codegen = SETL 1
    %1:gpr64codegen = SETL 2
    %2:gpr64codegen = SETL 3
    %3:gpr64codegen = ADDU %0, %1
    %4:gpr64codegen = ADDU %3, %2
...
---
name:            spill_fpr
tracksRegLiveness: true
registers:
  - { id: 0, class: fpr64codegen }
  - { id: 1, class: fpr64codegen }
  - { id: 2, class: fpr64codegen }
  - { id: 3, class: fpr64codegen }
  - { id: 4, class: fpr64codegen }
body:             |
  bb.0:
    ; SPILL-LABEL: name: spill_fpr
    ; SPILL-NOT: STSFI
    ; SPILL-NOT: LDSFI
    ; SPILL: STOUI {{.*}}, %stack.{{[0-9]+}}, 0 :: (store (s64)
    ; SPILL-NOT: STSFI
    ; SPILL-NOT: LDSFI
    ; SPILL: {{.*}} = LDOUI %stack.{{[0-9]+}}, 0 :: (load (s64)
    ; SPILL-NOT: STSFI
    ; SPILL-NOT: LDSFI
    %0:fpr64codegen = FLOTI 1, 1
    %1:fpr64codegen = FLOTI 1, 2
    %2:fpr64codegen = FLOTI 1, 3
    %3:fpr64codegen = FADD %0, %1
    %4:fpr64codegen = FADD %3, %2
...
