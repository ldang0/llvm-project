# RUN: llc -mtriple=mmix -verify-machineinstrs -run-pass=postrapseudos %s -o - | FileCheck %s

--- |
  target triple = "mmix"

  define void @callee() {
    ret void
  }

  define void @direct() {
    ret void
  }

  define void @indirect() {
    ret void
  }
...
---
name: direct
tracksRegLiveness: true
body: |
  bb.0:
    ; CHECK-LABEL: name: direct
    ; CHECK: PseudoPUSHJ $r31, @callee, csr_mmix, implicit-def $rj, implicit-def $rl, implicit-def $ro, implicit $r254, implicit $rg, implicit $rl, implicit $ro
    CALL_STATE @callee, csr_mmix
    RET implicit $rj, implicit $rl, implicit $ro, implicit $rg
...
---
name: indirect
tracksRegLiveness: true
body: |
  bb.0:
    liveins: $r250
    ; CHECK-LABEL: name: indirect
    ; CHECK: PseudoPUSHGO $r31, $r250, 0, csr_mmix, implicit-def $rj, implicit-def $rl, implicit-def $ro, implicit $r254, implicit $rg, implicit $rl, implicit $ro
    CALL_STATE $r250, csr_mmix
    RET implicit $rj, implicit $rl, implicit $ro, implicit $rg
...
