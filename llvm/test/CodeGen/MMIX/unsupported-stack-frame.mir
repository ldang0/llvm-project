# RUN: not --crash llc -mtriple=mmix -run-pass=prolog-epilog \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s

# CHECK: MMIX does not support dynamic stack allocation

--- |
  define void @dynamic_alloca() {
    ret void
  }
...
---
name:            dynamic_alloca
tracksRegLiveness: true
stack:
  - { id: 0, type: variable-sized, alignment: 8 }
body:             |
  bb.0:
    POP 0, 0
...
