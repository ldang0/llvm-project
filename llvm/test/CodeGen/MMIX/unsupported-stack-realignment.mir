# RUN: not llc -mtriple=mmix -run-pass=prolog-epilog \
# RUN:   -o /dev/null %s 2>&1 | FileCheck %s

# Unwind-enabled frames remain unsupported until their CFI describes realignment.
# CHECK: MMIX does not support stack realignment with unwind or debug information

--- |
  define void @overaligned_object() {
    ret void
  }
...
---
name:            overaligned_object
tracksRegLiveness: true
stack:
  - { id: 0, size: 16, alignment: 16 }
body:             |
  bb.0:
    POP 0, 0
...
