# REFERENCE-DAG: U __atomic_compare_exchange
# REFERENCE-DAG: U __atomic_exchange
# REFERENCE-DAG: U __atomic_is_lock_free
# REFERENCE-DAG: U __atomic_load
# REFERENCE-DAG: U __atomic_store
# REFERENCE-NOT: __atomic_fetch_add_8

# RESOLVED-DAG: T __atomic_compare_exchange
# RESOLVED-DAG: T __atomic_exchange
# RESOLVED-DAG: T __atomic_is_lock_free
# RESOLVED-DAG: T __atomic_load
# RESOLVED-DAG: T __atomic_store
