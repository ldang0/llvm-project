# ELF-COUNT-5: Format: elf64-mmix
# ELF: Arch: mmix
# ELF: DataEncoding: BigEndian
# ELF: Type: Relocatable
# ELF: Machine: EM_MMIX
# SYMBOL-DAG: T __divdc3
# SYMBOL-DAG: T __divsc3
# SYMBOL-DAG: T __ffsdi2
# SYMBOL-DAG: T __muldc3
# SYMBOL-DAG: T __mulsc3
# ATOMIC-ELF: Format: elf64-mmix
# ATOMIC-ELF: Arch: mmix
# ATOMIC-ELF: DataEncoding: BigEndian
# ATOMIC-ELF: Type: Relocatable
# ATOMIC-ELF: Machine: EM_MMIX
# ATOMIC-SYMBOL-DAG: T __atomic_load
# ATOMIC-SYMBOL-DAG: T __atomic_store
# ATOMIC-SYMBOL-DAG: T __atomic_exchange
# ATOMIC-SYMBOL-DAG: T __atomic_compare_exchange
# ATOMIC-SYMBOL-DAG: T __atomic_is_lock_free
# ATOMIC-SYMBOL-DAG: T __atomic_load_1
# ATOMIC-SYMBOL-DAG: T __atomic_load_2
# ATOMIC-SYMBOL-DAG: T __atomic_load_4
# ATOMIC-SYMBOL-DAG: T __atomic_load_8
# STACK-ELF: Format: elf64-mmix
# STACK-ELF: Arch: mmix
# STACK-ELF: DataEncoding: BigEndian
# STACK-ELF: Type: Relocatable
# STACK-ELF: Machine: EM_MMIX
# STACK-SYMBOL-DAG: W __mmix_stack_chk_terminate
# STACK-SYMBOL-DAG: T __stack_chk_fail
# STACK-SYMBOL-DAG: V __stack_chk_guard
# CXX-ELF: Format: elf64-mmix
# CXX-ELF: Arch: mmix
# CXX-ELF: DataEncoding: BigEndian
# CXX-ELF: Type: Relocatable
# CXX-ELF: Machine: EM_MMIX
# CXX-SYMBOL-DAG: W _ZdaPv
# CXX-SYMBOL-DAG: W _ZdaPvm
# CXX-SYMBOL-DAG: W _ZdlPv
# CXX-SYMBOL-DAG: W _ZdlPvm
# CXX-SYMBOL-DAG: W _Znam
# CXX-SYMBOL-DAG: W _Znwm
# CXX-SYMBOL-DAG: T __cxa_guard_acquire
# CXX-SYMBOL-DAG: T __cxa_guard_release
# CXX-SYMBOL-DAG: T __cxa_pure_virtual
# CXX-SYMBOL-DAG: D __dso_handle
# CXX-SYMBOL-NOT: __cxa_guard_abort
# CXX-DEPENDENCY-DAG: U abort
# CXX-DEPENDENCY-DAG: U free
# CXX-DEPENDENCY-DAG: U malloc

# CXX-MEMBERS:      cxx_delete.c.obj
# CXX-MEMBERS-NEXT: cxx_dso_handle.c.obj
# CXX-MEMBERS-NEXT: cxx_failure.c.obj
# CXX-MEMBERS-NEXT: cxx_guard.c.obj
# CXX-MEMBERS-NEXT: cxx_new.c.obj

# CXX-DEFINED-EXACT:      _ZdaPv
# CXX-DEFINED-EXACT-NEXT: _ZdaPvm
# CXX-DEFINED-EXACT-NEXT: _ZdlPv
# CXX-DEFINED-EXACT-NEXT: _ZdlPvm
# CXX-DEFINED-EXACT-NEXT: _Znam
# CXX-DEFINED-EXACT-NEXT: _Znwm
# CXX-DEFINED-EXACT-NEXT: __cxa_guard_acquire
# CXX-DEFINED-EXACT-NEXT: __cxa_guard_release
# CXX-DEFINED-EXACT-NEXT: __cxa_pure_virtual
# CXX-DEFINED-EXACT-NEXT: __dso_handle

# CXX-UNDEFINED-EXACT:      abort
# CXX-UNDEFINED-EXACT-NEXT: free
# CXX-UNDEFINED-EXACT-NEXT: malloc

# CXX-RELOCATIONS-EXACT:      R_MMIX_64 __dso_handle
# CXX-RELOCATIONS-EXACT-NEXT: R_MMIX_GETA free
# CXX-RELOCATIONS-EXACT-NEXT: R_MMIX_PUSHJ_STUBBABLE abort
# CXX-RELOCATIONS-EXACT-NEXT: R_MMIX_PUSHJ_STUBBABLE malloc

# UNUSED: T _start
# UNUSED: T main

#--- start.s
.text
.globl _start
.type _start,@function
_start:
  PUSHJ r31,main
1:
  JMP 1b
.size _start,.-_start

#--- empty.s
.text

#--- provider.c
static unsigned char storage[64];

void *malloc(__SIZE_TYPE__ size) {
  return size <= sizeof(storage) ? storage : (void *)0;
}

void free(void *pointer) { (void)pointer; }

__attribute__((noreturn)) void abort(void) {
  __builtin_trap();
}

#--- consumer.cpp
int main() {
  long *value = new long(7);
  long result = *value;
  delete value;
  return result != 7;
}

#--- empty.cpp
int main() { return 0; }

#--- link.ld
ENTRY(_start)
SECTIONS {
  . = 0x100000;
  .text : { *(.text .text.*) }
  .rodata : { *(.rodata .rodata.*) }
  .data : { *(.data .data.*) }
  .bss : { *(.bss .bss.*) *(COMMON) }
  .MMIX.reg_contents : { *(.MMIX.reg_contents) }
}
