# ELF:      File: {{.*}}resource/lib/mmix-unknown-unknown/libclang_rt.builtins.a(ffsdi2.c.obj)
# ELF:      Format: elf64-mmix
# ELF:      Arch: mmix
# ELF:      DataEncoding: BigEndian
# ELF:      Type: Relocatable
# ELF:      Machine: EM_MMIX
