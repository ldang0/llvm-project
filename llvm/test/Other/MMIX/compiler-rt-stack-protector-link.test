# ARCHIVE-DAG: W __mmix_stack_chk_terminate
# ARCHIVE-DAG: T __stack_chk_fail
# ARCHIVE-DAG: V __stack_chk_guard

# ABI-DAG: 20 FUNC WEAK DEFAULT {{[0-9]+}} __mmix_stack_chk_terminate
# ABI-DAG: 20 FUNC GLOBAL DEFAULT {{[0-9]+}} __stack_chk_fail
# ABI-DAG: 8 OBJECT WEAK DEFAULT {{[0-9]+}} __stack_chk_guard
# GUARD-SECTION: Name: .data
# GUARD-SECTION: Size: 8
# GUARD-SECTION: AddressAlignment: 8
# GUARD-VALUE: Contents of section .data:
# GUARD-VALUE-NEXT: 0000 4d4d4958 53535031
# FAIL-RELOC: R_MMIX_PUSHJ_STUBBABLE __mmix_stack_chk_terminate
# FAIL-CODE-LABEL: <__mmix_stack_chk_terminate>:
# FAIL-CODE: SWYM 0x0, 0x0, 0x0
# FAIL-CODE-NOT: TRAP
# FAIL-CODE-LABEL: <__stack_chk_fail>:
# FAIL-CODE: PUSHJ

# LINKED-DAG: W __mmix_stack_chk_terminate
# LINKED-DAG: T __stack_chk_fail
# LINKED-DAG: V __stack_chk_guard

# CRT-GUARD: D __stack_chk_guard
# CRT-GUARD-NOT: V __stack_chk_guard

# STRONG-HOOK: T __mmix_stack_chk_terminate
# STRONG-HOOK-NOT: W __mmix_stack_chk_terminate

# UNUSED-NOT: __mmix_stack_chk_terminate
# UNUSED-NOT: __stack_chk_fail
# UNUSED-NOT: __stack_chk_guard
