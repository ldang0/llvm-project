# ENTRY-LABEL: <_start>:
# ENTRY-NEXT:  SETL r255, 0xe7
# ENTRY-NEXT:  PUT rG, r255
# ENTRY-NEXT:  GET r254, rO
# ENTRY-NEXT:  SETL r255, 0x8000
# ENTRY-NEXT:  ADDU r254, r254, r255
# ENTRY-NEXT:  OR r231, r0, 0x0
# ENTRY-NEXT:  OR r232, r1, 0x0
# ENTRY-NEXT:  PUSHJ r31,
# ENTRY-NEXT:  {{.*}} R_MMIX_PUSHJ_STUBBABLE __llvm_libc_mmix_start_main
# ENTRY-NEXT:  SETL r255, 0x7f
# ENTRY-NEXT:  TRAP 0x0, 0x0, 0x0

# SECTIONS: Name: .text.init.enter

# SYMBOLS:      Name: _start
# SYMBOLS:      Size: 40
# SYMBOLS:      Binding: Global
# SYMBOLS:      Type: Function
# SYMBOLS:      Section: .text.init.enter
# SYMBOLS:      Name: __llvm_libc_mmix_start_main
# SYMBOLS:      Other [
# SYMBOLS-NEXT: STV_HIDDEN

# RELOCS: R_MMIX_PUSHJ_STUBBABLE __llvm_libc_mmix_start_main
# RELOCS: R_MMIX_PUSHJ_STUBBABLE main

# RUNTIME-SYMBOLS-DAG: T _Exit
# RUNTIME-SYMBOLS-DAG: T abort
# RUNTIME-SYMBOLS-DAG: T atexit
# RUNTIME-SYMBOLS-DAG: T exit
# RUNTIME-SYMBOLS-DAG: T __cxa_atexit
# RUNTIME-SYMBOLS-DAG: T __cxa_finalize
# RUNTIME-SYMBOLS-DAG: T __llvm_libc_exit
# RUNTIME-SYMBOLS-DAG: T __llvm_libc_stdio_teardown
# RUNTIME-SYMBOLS-DAG: T __mmix_stack_chk_terminate

# TERMINATION-LABEL: <__llvm_libc_exit>:
# TERMINATION:       AND {{.*}}, r231, 0xff
# TERMINATION:       TRAP 0x0, 0x0, 0x0
# TERMINATION-LABEL: <__llvm_libc_stdio_teardown>:
# TERMINATION:       POP
# TERMINATION-LABEL: <__mmix_stack_chk_terminate>:
# TERMINATION:       SETL {{.*}}, 0x7f
# TERMINATION:       TRAP 0x0, 0x0, 0x0

# ABORT-LABEL: <abort>:
# ABORT:       SETL {{.*}}, 0x86
# ABORT:       TRAP 0x0, 0x0, 0x0

# IMAGE:      Format: elf64-mmix
# IMAGE:      Type: Executable
# IMAGE:      Machine: EM_MMIX
# IMAGE:      Entry: 0x100000

# IMAGE-SYMBOLS:      Name: __llvm_libc_mmix_start_main
# IMAGE-SYMBOLS:      Name: _start
# IMAGE-SYMBOLS-NEXT: Value: 0x100000
# IMAGE-SYMBOLS:      Name: main

# FINAL-RELOCS: Relocations [
# FINAL-RELOCS-NEXT: ]

#--- main.c
int main(int argc, char **argv, char **envp) {
  return argc == 1 && argv != 0 && argv[0] != 0 && argv[1] == 0 && envp == 0
             ? 0
             : 1;
}
