# RUN: split-file %s %t
# RUN: cmake \
# RUN:   -DMMIX_ENTRYPOINTS=%S/../../../../libc/config/baremetal/mmix/entrypoints.txt \
# RUN:   -DMMIX_CONFIG=%S/../../../../libc/config/baremetal/mmix/config.json \
# RUN:   -P %t/check.cmake

#--- check.cmake
include(${MMIX_ENTRYPOINTS})

file(READ ${MMIX_CONFIG} config)
if(config MATCHES "LIBC_MATH_NO_ERRNO")
  message(FATAL_ERROR "MMIX numeric profile must preserve errno reporting")
endif()
if(NOT config MATCHES "LIBC_MATH_NO_EXCEPT")
  message(FATAL_ERROR "MMIX numeric profile must suppress unobservable fenv")
endif()

