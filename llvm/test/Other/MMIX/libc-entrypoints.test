# RUN: split-file %s %t
# RUN: cmake \
# RUN:   -DMMIX_ENTRYPOINTS=%S/../../../../libc/config/baremetal/mmix/entrypoints.txt \
# RUN:   -P %t/check.cmake

#--- check.cmake
include(${MMIX_ENTRYPOINTS})

set(expected_libc
    libc.src.ctype.isalnum
    libc.src.ctype.isalpha
    libc.src.ctype.isblank
    libc.src.ctype.iscntrl
    libc.src.ctype.isdigit
    libc.src.ctype.isgraph
    libc.src.ctype.islower
    libc.src.ctype.isprint
    libc.src.ctype.ispunct
    libc.src.ctype.isspace
    libc.src.ctype.isupper
    libc.src.ctype.isxdigit
    libc.src.ctype.tolower
    libc.src.ctype.toupper
    libc.src.locale.localeconv
    libc.src.locale.setlocale
    libc.src.inttypes.imaxabs
    libc.src.inttypes.imaxdiv
    libc.src.inttypes.strtoimax
    libc.src.inttypes.strtoumax
    libc.src.stdlib.abs
    libc.src.stdlib.atoi
    libc.src.stdlib.atol
    libc.src.stdlib.atoll
    libc.src.stdlib.bsearch
    libc.src.stdlib.div
    libc.src.stdlib.labs
    libc.src.stdlib.ldiv
    libc.src.stdlib.llabs
    libc.src.stdlib.lldiv
    libc.src.stdlib.mblen
    libc.src.stdlib.mbstowcs
    libc.src.stdlib.mbtowc
    libc.src.stdlib.qsort
    libc.src.stdlib.rand
    libc.src.stdlib.srand
    libc.src.stdlib.strtol
    libc.src.stdlib.strtoll
    libc.src.stdlib.strtoul
    libc.src.stdlib.strtoull
    libc.src.stdlib.wcstombs
    libc.src.stdlib.wctomb
    libc.src.errno.errno
    libc.src.stdlib._Exit
    libc.src.__support.OSUtil.baremetal.mmix.atexit
    libc.src.stdlib.exit
    libc.src.__support.OSUtil.baremetal.mmix.abort
    libc.src.stdlib.aligned_alloc
    libc.src.stdlib.calloc
    libc.src.stdlib.free
    libc.src.stdlib.malloc
    libc.src.stdlib.malloc_usable_size
    libc.src.stdlib.realloc
    libc.src.wchar.mbrlen
    libc.src.wchar.mbrtowc
    libc.src.wchar.mbsinit
    libc.src.wchar.mbsrtowcs
    libc.src.wchar.wcrtomb
    libc.src.wchar.wcsrtombs
    libc.src.string.memchr
    libc.src.string.memcmp
    libc.src.string.memcpy
    libc.src.string.memmove
    libc.src.string.memset
    libc.src.string.strcat
    libc.src.string.strchr
    libc.src.string.strcmp
    libc.src.string.strcoll
    libc.src.string.strcpy
    libc.src.string.strcspn
    libc.src.string.strerror
    libc.src.string.strlen
    libc.src.string.strncat
    libc.src.string.strncmp
    libc.src.string.strncpy
    libc.src.string.strpbrk
    libc.src.string.strrchr
    libc.src.string.strspn
    libc.src.string.strstr
    libc.src.string.strtok
    libc.src.string.strxfrm)
set(expected_libm
    libc.src.math.copysign
    libc.src.math.copysignf
    libc.src.math.fabs
    libc.src.math.fabsf)
set(expected_platform
    libc.src.__support.OSUtil.baremetal.mmix.platform_io
    libc.src.__support.OSUtil.baremetal.mmix.termination)

if(NOT TARGET_LIBC_ENTRYPOINTS STREQUAL expected_libc)
  message(FATAL_ERROR
    "unexpected MMIX libc entrypoints: ${TARGET_LIBC_ENTRYPOINTS}")
endif()
if(NOT TARGET_LIBM_ENTRYPOINTS STREQUAL expected_libm)
  message(FATAL_ERROR
    "unexpected MMIX libm entrypoints: ${TARGET_LIBM_ENTRYPOINTS}")
endif()
if(NOT TARGET_LIBC_PLATFORM_ENTRYPOINTS STREQUAL expected_platform)
  message(FATAL_ERROR
    "unexpected MMIX platform entrypoints: ${TARGET_LIBC_PLATFORM_ENTRYPOINTS}")
endif()

set(expected_all ${expected_libc} ${expected_libm} ${expected_platform})
if(NOT TARGET_LLVMLIBC_ENTRYPOINTS STREQUAL expected_all)
  message(FATAL_ERROR
    "unexpected combined MMIX entrypoints: ${TARGET_LLVMLIBC_ENTRYPOINTS}")
endif()

set(unique_entrypoints ${TARGET_LLVMLIBC_ENTRYPOINTS})
list(REMOVE_DUPLICATES unique_entrypoints)
if(NOT unique_entrypoints STREQUAL TARGET_LLVMLIBC_ENTRYPOINTS)
  message(FATAL_ERROR "duplicate MMIX entrypoint")
endif()

foreach(entrypoint IN LISTS TARGET_LIBC_ENTRYPOINTS)
  if(NOT entrypoint MATCHES
      "^libc[.]src[.](ctype|inttypes|locale|stdlib|string|wchar|errno|__support[.]OSUtil[.]baremetal[.]mmix)[.]")
    message(FATAL_ERROR "unreviewed MMIX libc family: ${entrypoint}")
  endif()
endforeach()
foreach(entrypoint IN LISTS TARGET_LIBM_ENTRYPOINTS)
  if(NOT entrypoint MATCHES "^libc[.]src[.]math[.]")
    message(FATAL_ERROR "unreviewed MMIX libm family: ${entrypoint}")
  endif()
endforeach()
foreach(entrypoint IN LISTS TARGET_LIBC_PLATFORM_ENTRYPOINTS)
  if(NOT entrypoint MATCHES
      "^libc[.]src[.]__support[.]OSUtil[.]baremetal[.]mmix[.]")
    message(FATAL_ERROR "unreviewed MMIX platform family: ${entrypoint}")
  endif()
endforeach()

set(unsupported_capability_families
    "^libc[.]src[.](spawn|unistd[.](exec|fork)|sys[.]wait)"
    "^libc[.]src[.]signal[.]"
    "^libc[.]src[.](time|unistd[.](sleep|usleep))[.]"
    "^libc[.]src[.]sys[.]random[.]"
    "^libc[.]src[.](pthread|threads)[.]"
    "^libc[.]src[.](dlfcn|link)[.]")
foreach(entrypoint IN LISTS TARGET_LLVMLIBC_ENTRYPOINTS)
  foreach(family IN LISTS unsupported_capability_families)
    if(entrypoint MATCHES "${family}")
      message(FATAL_ERROR
        "unsupported MMIX runtime capability selected: ${entrypoint}")
    endif()
  endforeach()
endforeach()
