# IMAGE:      Format: elf64-mmix
# IMAGE:      Type: Executable
# IMAGE:      Entry: 0x100000
# IMAGE:      Name: .text
# IMAGE:      Address: 0x100000
# IMAGE:      Name: .rodata
# IMAGE:      Name: .preinit_array
# IMAGE:      Name: .init_array
# IMAGE:      Name: .fini_array
# IMAGE:      Name: .data
# IMAGE:      Name: .bss
# IMAGE:      Name: .MMIX.reg_contents
# IMAGE-COUNT-3: Type: PT_LOAD
# IMAGE:      Relocations [
# IMAGE-NEXT: ]

# FORBIDDEN: Name: .text
# SYMBOLS-DAG: __bss_end B 106010 0
# SYMBOLS-DAG: __bss_size A 10 0
# SYMBOLS-DAG: __bss_start B 106000 0
# SYMBOLS-DAG: __data_end D 104008 0
# SYMBOLS-DAG: __data_size A 8 0
# SYMBOLS-DAG: __data_source A 104000 0
# SYMBOLS-DAG: __data_start D 104000 0
# SYMBOLS-DAG: __llvm_libc_argument_limit A 4000000000010000 0
# SYMBOLS-DAG: __llvm_libc_argument_start A 4000000000000000 0
# SYMBOLS-DAG: __llvm_libc_heap_limit A 4000000000800000 0
# SYMBOLS-DAG: __llvm_libc_image_end B 108000 0
# SYMBOLS-DAG: __llvm_libc_image_start T 100000 0
# SYMBOLS-DAG: _end A 4000000000010000 0
# SYMBOLS-DAG: _start T 100000 4
# PHDR:      Type: PT_LOAD
# PHDR:      Flags [ (0x5)
# PHDR-NEXT: PF_R
# PHDR-NEXT: PF_X
# PHDR:      Type: PT_LOAD
# PHDR:      Flags [ (0x4)
# PHDR-NEXT: PF_R
# PHDR:      Type: PT_LOAD
# PHDR:      Flags [ (0x6)
# PHDR-NEXT: PF_R
# PHDR-NEXT: PF_W
# REJECT: MMIX LLVM libc process image contains unsupported sections
# OVERFLOW: MMIX LLVM libc image exceeds QEMU Low RAM

#--- image.s
.section .text.init.enter,"ax",@progbits
.global _start
.type _start,@function
_start:
  SWYM 0, 0, 0
.size _start, .-_start

.section .rodata.runtime,"a",@progbits
.quad 0x1122334455667788

.section .preinit_array,"aw",@preinit_array
.quad _start
.section .init_array,"aw",@init_array
.quad _start
.section .fini_array,"aw",@fini_array
.quad _start

.section .data.runtime,"aw",@progbits
.quad 0x8877665544332211
.section .bss.runtime,"aw",@nobits
.space 16

.section .MMIX.reg_contents,"",@progbits
.quad 0

#--- forbidden.s
.section .text.init.enter,"ax",@progbits
.global _start
_start:
  SWYM 0, 0, 0
.section .tdata,"awT",@progbits
.quad 0

#--- overflow.s
.section .text.init.enter,"ax",@progbits
.global _start
_start:
  SWYM 0, 0, 0
.section .bss.runtime,"aw",@nobits
.space 0x06000000
