# RUN:   -I %S/../../../../libc/include -fsyntax-only %t/properties.c
# RUN: clang --target=mmix-unknown-elf -std=c17 -ffreestanding -nostdinc \
# RUN:   -isystem %S/../../../../clang/lib/Headers -I %t/include \
# RUN:   -I %S/../../../../libc/include -fsyntax-only %t/properties.c

#--- check-config.cmake
include(${MMIX_HEADERS})
set(expected_headers
    libc.include.assert
    libc.include.complex
    libc.include.ctype
    libc.include.errno
    libc.include.float
    libc.include.inttypes
    libc.include.limits
    libc.include.locale
    libc.include.math
    libc.include.setjmp
    libc.include.signal
    libc.include.stdint
    libc.include.stdio
    libc.include.stdlib
    libc.include.string
    libc.include.strings
    libc.include.time
    libc.include.uchar
    libc.include.wchar
    libc.include.wctype)
if(NOT TARGET_PUBLIC_HEADERS STREQUAL expected_headers)
  message(FATAL_ERROR
    "unexpected MMIX public headers: ${TARGET_PUBLIC_HEADERS}")
endif()

#--- properties.c
#include <assert.h>
#include <complex.h>
#include <ctype.h>
#include <errno.h>
#include <float.h>
#include <inttypes.h>
#include <limits.h>
#include <locale.h>
#include <math.h>
#include <setjmp.h>
#include <signal.h>
#include <stdarg.h>
#include <stdbool.h>
#include <stddef.h>
#include <stdint.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <time.h>
#include <tgmath.h>
#include <uchar.h>
#include <wchar.h>
#include <wctype.h>

#define SAME_TYPE(T, U) __builtin_types_compatible_p(T, U)

const volatile _Complex double qualified_complex;

_Static_assert(CHAR_BIT == 8 && CHAR_MIN < 0, "plain char model");
_Static_assert(SAME_TYPE(__typeof__(errno), int), "process errno type");
_Static_assert(sizeof(int8_t) == 1 && sizeof(int16_t) == 2,
               "narrow integer types");
_Static_assert(sizeof(int32_t) == 4 && sizeof(int64_t) == 8,
               "wide integer types");
_Static_assert(SAME_TYPE(intptr_t, long), "intptr_t");
_Static_assert(SAME_TYPE(uintptr_t, unsigned long), "uintptr_t");
_Static_assert(SAME_TYPE(intmax_t, long), "intmax_t");
_Static_assert(SAME_TYPE(uintmax_t, unsigned long), "uintmax_t");
_Static_assert(SIZE_MAX == ULONG_MAX && INT64_MAX == LONG_MAX,
               "integer limits");
_Static_assert(sizeof(PRId64) == sizeof("ld"), "int64 format");

_Static_assert(FLT_RADIX == 2 && FLT_MANT_DIG == 24, "float format");
_Static_assert(DBL_MANT_DIG == 53 && LDBL_MANT_DIG == 53,
               "double formats");
_Static_assert(FLT_EVAL_METHOD == 0, "floating evaluation method");
_Static_assert(SAME_TYPE(float_t, float), "float_t");
_Static_assert(SAME_TYPE(double_t, double), "double_t");
_Static_assert(!SAME_TYPE(double, long double), "distinct long double");
_Static_assert(sizeof(_Complex float) == 8, "float complex");
_Static_assert(sizeof(_Complex double) == 16, "double complex");
_Static_assert(sizeof(_Complex long double) == 16, "long double complex");
_Static_assert(SAME_TYPE(__typeof__(creal((_Complex float)0)), float),
               "type-generic creal float");
_Static_assert(SAME_TYPE(__typeof__(creal((_Complex double)0)), double),
               "type-generic creal double");
_Static_assert(SAME_TYPE(__typeof__(creal((_Complex long double)0)),
                         long double), "type-generic creal long double");
_Static_assert(SAME_TYPE(__typeof__(conj((_Complex float)0)),
                         _Complex float), "type-generic conj float");
_Static_assert(SAME_TYPE(__typeof__(conj((_Complex double)0)),
                         _Complex double), "type-generic conj double");
_Static_assert(SAME_TYPE(__typeof__(conj((_Complex long double)0)),
                         _Complex long double),
               "type-generic conj long double");
_Static_assert(SAME_TYPE(__typeof__(carg((_Complex float)0)), float),
               "type-generic carg float");
_Static_assert(SAME_TYPE(__typeof__(carg((_Complex double)0)), double),
               "type-generic carg double");
_Static_assert(SAME_TYPE(__typeof__(fabs(1)), double),
               "type-generic integer promotes to double");
_Static_assert(SAME_TYPE(__typeof__(fabs(1.0f)), float),
               "type-generic float remains float");
_Static_assert(SAME_TYPE(__typeof__(fabs(1.0L)), long double),
               "type-generic long double remains long double");
_Static_assert(SAME_TYPE(__typeof__(pow(1.0f, 2.0)), double),
               "type-generic mixed real promotes to double");
_Static_assert(SAME_TYPE(__typeof__(creal(qualified_complex)), double),
               "type-generic qualified complex selects double");

_Static_assert(SAME_TYPE(size_t, unsigned long), "size_t");
_Static_assert(SAME_TYPE(ptrdiff_t, long), "ptrdiff_t");
_Static_assert(SAME_TYPE(wchar_t, int), "wchar_t");
_Static_assert(_Alignof(max_align_t) == 8, "maximum alignment");
struct OffsetProbe {
  char padding;
  long value;
};
_Static_assert(offsetof(struct OffsetProbe, value) == 8, "offsetof");
_Static_assert(sizeof(div_t) == 8 && _Alignof(div_t) == 4, "div_t");
_Static_assert(sizeof(ldiv_t) == 16 && _Alignof(ldiv_t) == 8, "ldiv_t");
_Static_assert(sizeof(lldiv_t) == 16 && _Alignof(lldiv_t) == 8, "lldiv_t");
_Static_assert(sizeof(jmp_buf) == 40 && _Alignof(jmp_buf) == 8, "jmp_buf");
_Static_assert(SAME_TYPE(sig_atomic_t, int), "sig_atomic_t");
_Static_assert(SIGINT == 2 && SIGILL == 4 && SIGABRT == 6, "signals");
_Static_assert(SIGFPE == 8 && SIGSEGV == 11 && SIGTERM == 15, "signals");
_Static_assert(SAME_TYPE(clock_t, long) && sizeof(time_t) == 8, "time types");
_Static_assert(sizeof(mbstate_t) == 8 && _Alignof(mbstate_t) == 4,
               "multibyte state");
_Static_assert(sizeof(wchar_t) == 4 && sizeof(wint_t) == 4, "wide types");

typedef void (*signal_handler_t)(int);
static int (*const setjmp_declaration)(jmp_buf) = setjmp;
static void (*const longjmp_declaration)(jmp_buf, int) = longjmp;
static signal_handler_t (*const signal_declaration)(int, signal_handler_t) =
    signal;
static int (*const raise_declaration)(int) = raise;

static long read_variadic(int ignored, ...) {
  va_list args;
  va_start(args, ignored);
  long value = va_arg(args, long);
  va_list copy;
  va_copy(copy, args);
  va_end(copy);
  va_end(args);
  return value;
}

bool header_probe(void) {
  return read_variadic(0, 1L) == 1;
}
