# RUN: split-file %s %t
# RUN: %python -B %t/test.py %S/../../../../libcxx/utils/mmix/qemu.py

#--- test.py
import importlib.util
import contextlib
import io
import pathlib
import signal
import subprocess
import sys
import tempfile
import unittest
from unittest.mock import MagicMock, patch

spec = importlib.util.spec_from_file_location("executor", sys.argv.pop())
executor = importlib.util.module_from_spec(spec)
spec.loader.exec_module(executor)

class Classification(unittest.TestCase):
    def test_unsupported_environment_option(self):
        with contextlib.redirect_stderr(io.StringIO()), self.assertRaises(SystemExit) as error:
            executor.main(["--qemu", "qemu", "--execdir", ".", "--env=HOME=/", "guest"])
        self.assertEqual(error.exception.code, 2)

    def test_invalid_timeouts_never_launch(self):
        for timeout in ("0", "-1", "nan", "inf"):
            with contextlib.redirect_stderr(io.StringIO()), patch.object(executor, "run_process") as run:
                self.assertEqual(executor.main(["--qemu", "qemu", "--execdir", ".",
                                               "--timeout", timeout, "guest"]), 125)
                run.assert_not_called()

    def test_semantics_without_timing(self):
        for status in (0, 1, 73, 124, 125, 255):
            self.assertEqual(executor.classify(status, b"", False), ("guest-exit", status))
        self.assertEqual(executor.classify(-9, b"", False), ("qemu-signal", 125))
        self.assertEqual(executor.classify(0, b"bad image", False), ("qemu-diagnostic", 125))
        self.assertEqual(executor.classify(-9, b"", True), ("timeout", 124))

    def test_arguments(self):
        args = executor.command_line("qemu", "guest", ["a,b", "", "two words", "--flag"])
        self.assertIn("virt,elf-startup-abi=argc-argv", args)
        self.assertEqual(args[args.index("-smp") + 1], "1")
        self.assertTrue(args[-1].endswith(",arg=guest,arg=a,,b,arg=,arg=two words,arg=--flag"))
        with self.assertRaises(ValueError):
            executor.command_line("qemu", "guest", ["\0"])

    def test_native_image_only(self):
        with tempfile.TemporaryDirectory() as directory:
            image = pathlib.Path(directory) / "image"
            valid = b"\x7fELF\x02\x02\x01" + bytes(9) + b"\x00\x02\x00\x50"
            image.write_bytes(valid)
            executor.validate_binary(image)
            for data in (b"#!/bin/sh", valid[:4] + b"\x01" + valid[5:],
                         valid[:16] + b"\x00\x01\x00\x50", valid[:18] + b"\x00\x3e"):
                image.write_bytes(data)
                with self.assertRaises(ValueError):
                    executor.validate_binary(image)

class TimeoutMechanics(unittest.TestCase):
    def test_kill_group_and_reap_preserve_output(self):
        child = MagicMock(pid=42, returncode=-9)
        child.__enter__.return_value = child
        child.communicate.side_effect = [subprocess.TimeoutExpired("qemu", 1), (b"partial", b"diagnostic")]
        with patch.object(executor.subprocess, "Popen", return_value=child), patch.object(executor.os, "killpg") as kill:
            self.assertEqual(executor.run_process(["qemu"], ".", 1), (-9, b"partial", b"diagnostic", True))
            kill.assert_called_once_with(42, signal.SIGKILL)
            self.assertEqual(child.communicate.call_count, 2)

    def test_real_sleep_is_bounded_without_startup_deadline(self):
        result = executor.run_process([sys.executable, "-c", "import time; time.sleep(3600)"], ".", 0.1)
        self.assertTrue(result[3])
        self.assertLess(result[0], 0)

unittest.main()
