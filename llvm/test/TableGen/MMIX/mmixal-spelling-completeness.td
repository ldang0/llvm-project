assert !eq(!size(MMIXALExpectedMnemonics), 256),
       "MMIXAL mnemonic inventory is incomplete";
assert !eq(!size(MMIXALExpectedSelections), 256),
       "MMIXAL selection inventory is incomplete";
assert !eq(!size(MMIXALExpectedOperandForms), 256),
       "MMIXAL operand-form inventory is incomplete";

foreach Opcode = 0-255 in {
  assert !eq(MMIXExpectedRecordsByOpcode[Opcode].MMIXOpcode, Opcode),
         "MMIXAL spelling is attached to the wrong opcode record";
  assert !eq(MMIXExpectedRecordsByOpcode[Opcode].MMIXALMnemonic,
             MMIXALExpectedMnemonics[Opcode]),
         "MMIXAL mnemonic metadata differs from the reviewed inventory";
  assert !eq(MMIXExpectedRecordsByOpcode[Opcode].MMIXALSelection,
             MMIXALExpectedSelections[Opcode]),
         "MMIXAL selection metadata differs from the reviewed inventory";
  assert !eq(MMIXExpectedRecordsByOpcode[Opcode].MMIXALOperandForm,
             MMIXALExpectedOperandForms[Opcode]),
         "MMIXAL operand-form metadata differs from the reviewed inventory";
}
