## Debug stripping is a semantic no-op for these debug-free objects.
# RUN: llvm-strip --strip-debug %t/llvm.o -o %t/llvm.debug.o
# RUN: llvm-strip --strip-debug %t/gnu.o -o %t/gnu.debug.o
# RUN: cmp %t/llvm.o %t/llvm.debug.o
# RUN: cmp %t/gnu.o %t/gnu.debug.o

## Discarding locals retains every symbol needed by an object relocation.
# RUN: llvm-strip --discard-all %t/llvm.o -o %t/llvm.discard.o
# RUN: llvm-readobj --symbols --relocations %t/llvm.discard.o \
# RUN:   | FileCheck %s --check-prefix=OBJECT
# OBJECT-DAG: R_MMIX_GETA gnu_data
# OBJECT-DAG: R_MMIX_PUSHJ_STUBBABLE gnu_function
# OBJECT-DAG: R_MMIX_ADDR27 llvm_entry
# OBJECT-DAG: R_MMIX_64 gnu_data
# OBJECT-DAG: Name: llvm_entry
# OBJECT-DAG: Name: gnu_data
# OBJECT-DAG: Name: gnu_function
# OBJECT-NOT: Name: llvm_local_function

## Strip-all removes symbol tables without changing loadable executable bytes.
# RUN: llvm-strip --strip-all %t/lld.elf -o %t/lld.strip.elf
# RUN: llvm-strip --strip-all %t/gnu.elf -o %t/gnu.strip.elf
# RUN: llvm-objcopy -O binary %t/lld.elf %t/lld.before.bin
# RUN: llvm-objcopy -O binary %t/lld.strip.elf %t/lld.after.bin
# RUN: llvm-objcopy -O binary %t/gnu.elf %t/gnu.before.bin
# RUN: llvm-objcopy -O binary %t/gnu.strip.elf %t/gnu.after.bin
# RUN: cmp %t/lld.before.bin %t/lld.after.bin
# RUN: cmp %t/gnu.before.bin %t/gnu.after.bin
# RUN: llvm-readobj --file-headers --program-headers --sections --symbols \
# RUN:   %t/lld.strip.elf | FileCheck %s --check-prefix=STRIPPED
# RUN: llvm-objdump --no-print-imm-hex -d -s %t/lld.strip.elf \
# RUN:   | FileCheck %s --check-prefix=CONTENTS
# STRIPPED:      Type: Executable
# STRIPPED:      Machine: EM_MMIX
# STRIPPED:      Entry: 0x1004
# STRIPPED:      Name: .MMIX.reg_contents
# STRIPPED:      Type: PT_LOAD
# STRIPPED:      Symbols [
# STRIPPED-NEXT: ]
# CONTENTS:      Contents of section .MMIX.reg_contents:
# CONTENTS:      07f0 88776655 44332211
# CONTENTS:      Disassembly of section .text:
# CONTENTS:      SWYM 0, 0, 0
# CONTENTS:      GETA r1, 2051
# CONTENTS:      PUSHJ r2, 3
# CONTENTS:      JMPB -5

## Explicitly removing a relocation-required symbol remains an error.
# RUN: not llvm-strip --strip-symbol gnu_data %t/llvm.o -o %t/invalid.o 2>&1 \
# RUN:   | FileCheck %s --check-prefix=REQUIRED -DINPUT=%t/llvm.o
# REQUIRED: error: '[[INPUT]]': not stripping symbol 'gnu_data' because it is named in a relocation
