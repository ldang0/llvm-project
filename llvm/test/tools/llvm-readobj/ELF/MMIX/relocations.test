# EXPANDED-NEXT:     Addend: 0x0
# EXPANDED-NEXT:   }
# EXPANDED-NEXT:   Relocation {
# EXPANDED-NEXT:     Offset: 0x1
# EXPANDED-NEXT:     Type: R_MMIX_8 (1)
