## Test that llvm-readobj recognizes all 37 GNU MMIX relocation identities.
## These synthetic records check names and values only; they do not imply that
## LLVM produces or applies every relocation.

# RUN: yaml2obj %S/../../../Inputs/MMIX/relocations.yaml -o %t.o
# RUN: llvm-readobj --relocations %t.o 2>&1 \
# RUN:   | FileCheck %s --check-prefix=COMPACT --implicit-check-not=warning: \
# RUN:     --implicit-check-not=error:
# RUN: llvm-readobj --relocations --expand-relocs %t.o 2>&1 \
# RUN:   | FileCheck %s --check-prefix=EXPANDED --implicit-check-not=warning: \
# RUN:     --implicit-check-not=error:

# COMPACT:      Relocations [
# COMPACT-NEXT:   Section (3) .rela.data {
# COMPACT-NEXT:     0x0 R_MMIX_NONE - 0x0
# COMPACT-NEXT:     0x1 R_MMIX_8 local_data 0x0
# COMPACT-NEXT:     0x2 R_MMIX_16 external 0x4
# COMPACT-NEXT:     0x4 R_MMIX_24 .data 0x8
# COMPACT-NEXT:     0x8 R_MMIX_32 weak_target 0xFFFFFFFFFFFFFFFC
# COMPACT-NEXT:     0x10 R_MMIX_64 local_data 0x10
# COMPACT-NEXT:     0x18 R_MMIX_PC_8 external 0xFFFFFFFFFFFFFFFF
# COMPACT-NEXT:     0x1A R_MMIX_PC_16 local_data 0x2
# COMPACT-NEXT:     0x1C R_MMIX_PC_24 .data 0x4
# COMPACT-NEXT:     0x20 R_MMIX_PC_32 weak_target 0xFFFFFFFFFFFFFFF8
# COMPACT-NEXT:     0x28 R_MMIX_PC_64 external 0x10
# COMPACT-NEXT:     0x30 R_MMIX_GNU_VTINHERIT local_data 0x0
# COMPACT-NEXT:     0x38 R_MMIX_GNU_VTENTRY external 0x3
# COMPACT-NEXT:   }
# COMPACT-NEXT:   Section (4) .rela.text {
# COMPACT-NEXT:     0x0 R_MMIX_GETA external 0x0
# COMPACT-NEXT:     0x4 R_MMIX_GETA_1 local_func 0x4
# COMPACT-NEXT:     0x8 R_MMIX_GETA_2 weak_target 0xFFFFFFFFFFFFFFFC
# COMPACT-NEXT:     0xC R_MMIX_GETA_3 .text 0x8
# COMPACT-NEXT:     0x10 R_MMIX_CBRANCH external 0x0
# COMPACT-NEXT:     0x14 R_MMIX_CBRANCH_J local_func 0x4
# COMPACT-NEXT:     0x18 R_MMIX_CBRANCH_1 weak_target 0xFFFFFFFFFFFFFFFC
# COMPACT-NEXT:     0x1C R_MMIX_CBRANCH_2 .text 0x8
# COMPACT-NEXT:     0x20 R_MMIX_CBRANCH_3 external 0xFFFFFFFFFFFFFFF8
# COMPACT-NEXT:     0x24 R_MMIX_PUSHJ local_func 0x0
# COMPACT-NEXT:     0x28 R_MMIX_PUSHJ_1 weak_target 0x4
# COMPACT-NEXT:     0x2C R_MMIX_PUSHJ_2 .text 0xFFFFFFFFFFFFFFFC
# COMPACT-NEXT:     0x30 R_MMIX_PUSHJ_3 external 0x8
# COMPACT-NEXT:     0x34 R_MMIX_JMP local_func 0xFFFFFFFFFFFFFFF8
# COMPACT-NEXT:     0x38 R_MMIX_JMP_1 weak_target 0x0
# COMPACT-NEXT:     0x3C R_MMIX_JMP_2 .text 0x4
# COMPACT-NEXT:     0x40 R_MMIX_JMP_3 external 0xFFFFFFFFFFFFFFFC
# COMPACT-NEXT:     0x44 R_MMIX_ADDR19 local_func 0x8
# COMPACT-NEXT:     0x48 R_MMIX_ADDR27 weak_target 0xFFFFFFFFFFFFFFF8
# COMPACT-NEXT:     0x4C R_MMIX_REG_OR_BYTE .text 0x0
# COMPACT-NEXT:     0x50 R_MMIX_REG external 0x4
# COMPACT-NEXT:     0x54 R_MMIX_BASE_PLUS_OFFSET local_func 0xFFFFFFFFFFFFFFFC
# COMPACT-NEXT:     0x58 R_MMIX_LOCAL weak_target 0x8
# COMPACT-NEXT:     0x5C R_MMIX_PUSHJ_STUBBABLE external 0xFFFFFFFFFFFFFFF8
# COMPACT-NEXT:   }
# COMPACT-NEXT: ]

## No-op and absolute data records.
# EXPANDED:      Section (3) .rela.data {
# EXPANDED-NEXT:   Relocation {
# EXPANDED-NEXT:     Offset: 0x0
